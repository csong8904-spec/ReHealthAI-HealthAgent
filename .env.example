# Environment variables for ReHealth HealthAgent
# Copy this file to .env and fill in only what you need.
# NEVER commit .env.

# --- LLM backend (optional) ---
# When absent, the simulator runs in deterministic offline mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Force the rule-based adherence model even if a key is present.
REHEALTH_OFFLINE=

# --- HTTP API ---
# When set, every /api/* request must send the X-API-Key header.
REHEALTH_API_KEY=
# Comma-separated allow-list; use * only for local development.
REHEALTH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Persistence ---
# Default: ~/.rehealth/patients.db
REHEALTH_DB_PATH=
