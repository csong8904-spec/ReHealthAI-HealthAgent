# ReHealth HealthAgent — environment variables
# Copy this file to .env and fill in only what you need.
# 环境变量模板：复制为 .env，只填写需要的项。切勿提交 .env。

# --- LLM backend (optional) / LLM 后端（可选）---
# When absent, the simulator runs in deterministic offline mode.
# 未设置时，模拟器自动运行在确定性离线模式。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Force the rule-based adherence model even if a key is present.
# 即使存在 Key，也强制使用规则化依从模型。
REHEALTH_OFFLINE=

# --- HTTP API / HTTP 接口 ---
# When set, every /api/* request must send the X-API-Key header.
# 设置后，所有 /api/* 请求都必须携带 X-API-Key 请求头。
REHEALTH_API_KEY=
# Comma-separated allow-list; use * only for local development.
# 逗号分隔的允许来源列表；仅在本地开发时使用 *。
REHEALTH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Persistence / 持久化 ---
# Default: ~/.rehealth/patients.db
# 默认：~/.rehealth/patients.db
REHEALTH_DB_PATH=
